{
	"name": "magnet-manager-web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
		"dev:server": "nodemon server/index.js",
		"dev:client": "vite --config client/vite.config.js",
		"build": "vite build --config client/vite.config.js",
		"preview": "vite preview --config client/vite.config.js",
		"start": "node server/index.js"
	},
	"dependencies": {
		"cors": "^2.8.5",
		"express": "^4.19.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@vitejs/plugin-react": "^4.3.1",
		"concurrently": "^9.0.1",
		"nodemon": "^3.1.4",
		"vite": "^5.4.8"
	}
}